{
  "name": "innnorsk",
  "productName": "InnNorsk",
  "version": "1.2.0",
  "description": "Oversett dokumenter til norsk med Grok — skyapp med innlogging, og lokal Windows-app.",
  "main": "src/main.js",
  "author": "InnNorsk",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "server": "node --disable-warning=ExperimentalWarning server/index.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch server/index.js",
    "create-user": "node --disable-warning=ExperimentalWarning server/cli.js create-user",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 \"test/**/*.test.js\"",
    "pack:win": "electron-packager . InnNorsk --platform=win32 --arch=x64 --out=dist --overwrite --icon=assets/icon.ico --ignore=\"dist|docs|packaging|site|server|web|test|data|Dockerfile|render.yaml\"",
    "pack:mac": "electron-packager . InnNorsk --platform=darwin --arch=arm64 --out=dist --overwrite --icon=assets/icon.icns --ignore=\"dist|docs|packaging|site|server|web|test|data|Dockerfile|render.yaml\""
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.1",
    "hono": "^4.13.9",
    "jszip": "^3.10.1",
    "unpdf": "^1.8.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^35.1.5",
    "electron-packager": "^17.1.2",
    "wrangler": "^4.138.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}
