{
  "name": "innnorsk",
  "productName": "InnNorsk",
  "version": "1.2.0",
  "description": "Oversett dokumenter til norsk med Grok — skyapp på Cloudflare med innlogging, og lokal Windows-app.",
  "main": "src/main.js",
  "author": "InnNorsk",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply innnorsk --local",
    "deploy": "wrangler d1 migrations apply innnorsk --remote && wrangler deploy",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 \"test/**/*.test.js\"",
    "e2e": "node test/e2e/e2e.js",
    "make-user": "node scripts/make-user.js",
    "pack:win": "electron-packager . InnNorsk --platform=win32 --arch=x64 --out=dist --overwrite --icon=assets/icon.ico --ignore=\"^/(dist|docs|packaging|site|worker|web|test|migrations|mac|ios)(/|$)|^/scripts/make-user\\.js$|^/wrangler\\.jsonc$|^/\\.wrangler(/|$)|^/\\.dev\\.vars\"",
    "pack:mac": "electron-packager . InnNorsk --platform=darwin --arch=arm64 --out=dist --overwrite --icon=assets/icon.icns --ignore=\"^/(dist|docs|packaging|site|worker|web|test|migrations|mac|ios)(/|$)|^/scripts/make-user\\.js$|^/wrangler\\.jsonc$|^/\\.wrangler(/|$)|^/\\.dev\\.vars\""
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.1",
    "hono": "^4.13.9",
    "jszip": "^3.10.1",
    "unpdf": "^1.8.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^35.1.5",
    "electron-packager": "^17.1.2",
    "wrangler": "^4.138.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}
