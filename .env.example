# InnNorsk Sky — miljøvariabler. Kopier til .env og fyll inn (.env committes aldri).
# Start lokalt med filen:
#   node --env-file=.env --disable-warning=ExperimentalWarning server/index.js
# På Render settes de under Environment (se docs/DEPLOY.md).

# --- Må settes ---

# xAI-nøkkel fra https://console.x.ai. Må ha chat/model-tilgang (api-key:endpoint:* og api-key:model:*),
# ikke bare voice. Uten nøkkel starter appen, men kan ikke oversette (admin ser en advarsel).
XAI_API_KEY=

# Første administrator. Brukes bare ved første oppstart, når databasen ikke har noen brukere.
# Etterpå byttes passordet inne i appen. Velg et langt passord (minst 10 tegn).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Valgfritt (standardverdi i parentes) ---

# Port serveren lytter på (8080).
# PORT=8080

# Mappe for database (innnorsk.db) og filer. Lokalt ./data, i Docker /data.
# DATA_DIR=./data

# Grok-modell (grok-4.6).
# XAI_MODEL=grok-4.6

# xAI-adresse (https://api.x.ai). Pek mot en falsk server under utvikling og testing,
# f.eks. http://127.0.0.1:18080 med test/helpers/mock-xai-server.js.
# XAI_BASE_URL=https://api.x.ai

# Antall parallelle Grok-kall innen samme fil (2).
# GROK_CONCURRENCY=2

# Tidsgrense per Grok-kall i millisekunder (240000 = 4 min).
# GROK_TIMEOUT_MS=240000

# Hvor mange dager en innlogging varer uten aktivitet (14).
# SESSION_DAYS=14

# Opplastede og oversatte filer slettes etter så mange dager (14). Jobboversikten beholdes.
# RETENTION_DAYS=14

# Maks størrelse per fil i MB (50) og maks antall filer per jobb (200).
# MAX_FILE_MB=50
# MAX_FILES_PER_JOB=200

# Secure-flagg på innloggingscookien (auto = på når NODE_ENV=production).
# Krever HTTPS; localhost fungerer uansett.
# COOKIE_SECURE=auto

# Antall proxyer foran appen, for riktig IP-adresse i loggen (1, passer Render).
# TRUST_PROXY=1

# Loggnivå: debug, info, warn eller error (info). Debug lagres bare i databasen når dette er debug.
# LOG_LEVEL=info

# Hendelser i loggen slettes etter så mange dager (90).
# EVENT_RETENTION_DAYS=90

# Tidsestimat: sekunder per Grok-kall = EST_A + EST_B × tegn (8 og 0.006).
# Kalibreres automatisk fra historikken; overstyr bare ved behov.
# EST_A=8
# EST_B=0.006

# production gir sikre cookies. Settes automatisk i Docker-imaget.
# NODE_ENV=production
