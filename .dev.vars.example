# Lokale hemmeligheter for `npm run dev` (wrangler dev). Kopier til .dev.vars og fyll inn.
# .dev.vars er i .gitignore og skal aldri committes. Skriv aldri ekte verdier i denne filen.

# Nøkkelen Mac-agenten bruker mot /api/agent/* (lang og tilfeldig, f.eks. `openssl rand -base64 36`).
AGENT_TOKEN=

# Push til iPhone (APNs). Hele teksten i .p8-filen fra developer.apple.com, med linjeskift som \n.
APNS_KEY_P8=
APNS_KEY_ID=
APNS_TEAM_ID=

# Valgfri: gjør de falske saltene for ukjente brukernavn unike for din installasjon.
SALT_PEPPER=

# Utvikling uten ekte APNs: pek på en lokal falsk APNs-server (se test/helpers/mock-apns.js).
# APNS_BASE_URL=http://127.0.0.1:18443
